{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.10.0"},
    {ranch, "2.1.0"},
    {jsx, "3.1.0"}            %% runtime JSON for simple-json's purerl FFI (Reef.Protocol)
]}.

{shell, [
    {apps, [cowboy, ranch]}
]}.

%% purerl-tidal is a DEPS-ONLY rebar project: the app is compiled by erlc
%% (make erl-quick), NOT rebar3 — rebar3 only fetches/builds cowboy/ranch/jsx.
%% Without this, rebar3 treats the repo root as an app and tries to compile the
%% purerl FFI files in src/**, whose @foreign module names deliberately do not
%% match their filenames (paired with .purs), and errors.
{project_app_dirs, []}.
